{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "glorifier",
  "compatibility_date": "2026-10-12",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api",
      "/api/*",
      "/auth",
      "/auth/*"
    ]
  },
  "previews": {},
  "main": "./src/worker.ts"
}
